# Supabase connection (server-side only — used by API routes, never shipped to the browser)
SUPABASE_URL=https://YOUR-PROJECT-ref.supabase.co

# Use ONE of the following. The service-role key is recommended for production
# (keep RLS enabled so only the server can reach the tables). The anon key also
# works because the tables are created with RLS disabled.
SUPABASE_SERVICE_ROLE_KEY=your-service-role-key
# SUPABASE_ANON_KEY=your-anon-key
